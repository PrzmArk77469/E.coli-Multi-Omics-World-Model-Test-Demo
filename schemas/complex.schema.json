{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ecoli-world/complex.schema.json",
  "title": "Complex",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "complex_uid",
    "representative_x",
    "representative_y",
    "representative_z",
    "r_eff",
    "behavior_profile_id",
    "component_count",
    "created_event_id",
    "created_at",
    "member_agent_uids"
  ],
  "properties": {
    "complex_uid": {"type": "string", "minLength": 1},
    "representative_x": {"type": "number"},
    "representative_y": {"type": "number"},
    "representative_z": {"type": "number"},
    "r_eff": {"type": "number", "exclusiveMinimum": 0},
    "behavior_profile_id": {"type": "string", "minLength": 1},
    "component_count": {"type": "integer", "minimum": 2},
    "created_event_id": {"type": "integer", "minimum": 1},
    "created_at": {"type": "number", "minimum": 0},
    "member_agent_uids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    }
  }
}
